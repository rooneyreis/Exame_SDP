# Copy to .env and adjust. Secrets live in infra/keys and infra/certs (generated, not versioned).
COMPOSE_PROJECT_NAME=gss

# Regions served (single source of truth for auth, api and coordinator).
# Each one needs its shard (pg-<region> + replica) in docker-compose.yml.
GSS_REGIONS=EU,AM,AF

# PostgreSQL superuser password (all nodes) and replication user password
POSTGRES_PASSWORD=change-me
REPLICATION_PASSWORD=change-me-too

# Legacy bank: settlement orders above this amount are rejected
MAX_SETTLEMENT=20000
